# PostgreSQL connection string used by Prisma.
# Local Docker (see docker-compose.yml):
DATABASE_URL="postgresql://infra360:infra360@localhost:5432/infra360?schema=public"

# If using a hosted database instead (Supabase, Neon, etc.), replace the value above
# with the connection string they provide, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
